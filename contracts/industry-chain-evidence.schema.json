{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fourseasquant.local/contracts/industry-chain-evidence.schema.json",
  "title": "IndustryChainEvidenceSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_id",
    "event_id",
    "source",
    "headline",
    "published_at",
    "collected_at",
    "content_sha256",
    "language",
    "is_reprint",
    "retention_mode",
    "facts"
  ],
  "properties": {
    "schema_version": {
      "const": "industry-chain-evidence-v0.1"
    },
    "evidence_id": {
      "type": "string",
      "minLength": 1
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "$ref": "#/$defs/Source"
    },
    "headline": {
      "type": "string",
      "minLength": 1
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "collected_at": {
      "type": "string",
      "format": "date-time"
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "language": {
      "type": "string",
      "minLength": 2
    },
    "is_reprint": {
      "type": "boolean"
    },
    "reprint_cluster_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "retention_mode": {
      "enum": [
        "metadata_only",
        "model_selected_excerpts",
        "official_original"
      ]
    },
    "original_file_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/EvidenceFact"
      }
    }
  },
  "$defs": {
    "Source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_name",
        "source_tier",
        "source_type",
        "url",
        "is_primary",
        "access_class"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "source_name": {
          "type": "string",
          "minLength": 1
        },
        "source_tier": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "source_type": {
          "enum": [
            "company_filing",
            "exchange",
            "regulator",
            "government",
            "statistics",
            "industry_association",
            "company_official",
            "financial_media",
            "industry_media",
            "aggregator",
            "forum",
            "social",
            "local_database",
            "other"
          ]
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "is_primary": {
          "type": "boolean"
        },
        "access_class": {
          "enum": [
            "public_no_login",
            "user_provided_licensed",
            "inaccessible"
          ]
        }
      }
    },
    "EvidenceFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fact_id",
        "fact_type",
        "subject",
        "statement",
        "disclosure_mode",
        "excerpt",
        "retention_reason"
      ],
      "properties": {
        "fact_id": {
          "type": "string",
          "minLength": 1
        },
        "fact_type": {
          "enum": [
            "supply_contraction",
            "demand_increase",
            "inventory_depletion",
            "order_delivery",
            "price_change",
            "capacity",
            "business_materiality",
            "ownership",
            "customer_relationship",
            "policy_observation",
            "other_supply_demand"
          ]
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "disclosure_mode": {
          "enum": [
            "quantitative",
            "official_qualitative",
            "media_reported",
            "unverified_lead"
          ]
        },
        "numeric_value": {
          "type": [
            "number",
            "null"
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "period": {
          "type": [
            "string",
            "null"
          ]
        },
        "excerpt": {
          "type": "string",
          "minLength": 1
        },
        "retention_reason": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
