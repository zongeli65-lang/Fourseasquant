{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fourseasquant.local/contracts/industry-chain-outcome-validation.schema.json",
  "title": "IndustryChainOutcomeValidation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "validation_id",
    "selection_id",
    "evaluation_version",
    "evaluation_cutoff",
    "business_horizon",
    "label",
    "business_outcomes",
    "market_diagnostics",
    "evidence_refs",
    "training_eligible",
    "explanation"
  ],
  "properties": {
    "schema_version": {
      "const": "industry-chain-outcome-validation-v0.1"
    },
    "validation_id": {
      "type": "string",
      "minLength": 1
    },
    "selection_id": {
      "type": "string",
      "minLength": 1
    },
    "evaluation_version": {
      "type": "string",
      "minLength": 1
    },
    "evaluation_cutoff": {
      "type": "string",
      "format": "date-time"
    },
    "business_horizon": {
      "enum": [
        "one_quarter",
        "two_quarters"
      ]
    },
    "label": {
      "enum": [
        "correct",
        "incorrect",
        "uncertain"
      ]
    },
    "business_outcomes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/BusinessOutcome"
      }
    },
    "market_diagnostics": {
      "$ref": "#/$defs/MarketDiagnostics"
    },
    "evidence_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "training_eligible": {
      "type": "boolean"
    },
    "explanation": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "BusinessOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "metric",
        "direction",
        "value",
        "unit",
        "period",
        "evidence_refs"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^\\d{6}$"
        },
        "metric": {
          "enum": [
            "product_volume",
            "product_price",
            "orders",
            "capacity_utilization",
            "segment_revenue",
            "segment_gross_profit",
            "investment_income",
            "official_qualitative_realization",
            "other_business_realization"
          ]
        },
        "direction": {
          "enum": [
            "positive",
            "negative",
            "unchanged",
            "unknown"
          ]
        },
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "period": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "MarketDiagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relative_return_5d",
        "relative_return_10d",
        "relative_return_20d",
        "benchmark"
      ],
      "properties": {
        "relative_return_5d": {
          "type": [
            "number",
            "null"
          ]
        },
        "relative_return_10d": {
          "type": [
            "number",
            "null"
          ]
        },
        "relative_return_20d": {
          "type": [
            "number",
            "null"
          ]
        },
        "benchmark": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
