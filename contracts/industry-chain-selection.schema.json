{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fourseasquant.local/contracts/industry-chain-selection.schema.json",
  "title": "IndustryChainLeaderSelectionSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "selection_id",
    "selection_version",
    "event_id",
    "rules_version",
    "model",
    "prompt_version",
    "knowledge_version",
    "stock_universe_version",
    "trigger_method",
    "as_of_time",
    "started_at",
    "completed_at",
    "status",
    "decision_authority",
    "immutable",
    "contains_trading_instruction",
    "event",
    "candidates",
    "summary",
    "unresolved_items"
  ],
  "properties": {
    "schema_version": {
      "const": "industry-chain-selection-v0.1"
    },
    "selection_id": {
      "type": "string",
      "minLength": 1
    },
    "selection_version": {
      "type": "integer",
      "minimum": 1
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "rules_version": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "$ref": "#/$defs/ModelRuntime"
    },
    "prompt_version": {
      "type": "string",
      "minLength": 1
    },
    "knowledge_version": {
      "type": "string",
      "minLength": 1
    },
    "stock_universe_version": {
      "type": "string",
      "minLength": 1
    },
    "trigger_method": {
      "enum": [
        "automatic",
        "manual",
        "new_evidence",
        "historical_replay",
        "user_feedback"
      ]
    },
    "as_of_time": {
      "type": "string",
      "format": "date-time"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "selected",
        "empty",
        "evidence_insufficient"
      ]
    },
    "decision_authority": {
      "const": "candidate_selection_only"
    },
    "immutable": {
      "const": true
    },
    "contains_trading_instruction": {
      "const": false
    },
    "event": {
      "$ref": "#/$defs/SupplyDemandEvent"
    },
    "candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/LeaderCandidate"
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "unresolved_items": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "ModelRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id",
        "model_revision",
        "quantization",
        "runtime_id",
        "temperature"
      ],
      "properties": {
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "model_revision": {
          "type": "string",
          "minLength": 1
        },
        "quantization": {
          "type": "string",
          "minLength": 1
        },
        "runtime_id": {
          "type": "string",
          "minLength": 1
        },
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        }
      }
    },
    "SupplyDemandEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "event_time",
        "trigger_types",
        "affected_product_or_service",
        "gap_node",
        "industry_evidence_refs",
        "policy_only"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "event_time": {
          "type": "string",
          "format": "date-time"
        },
        "trigger_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "supply_contraction",
              "demand_increase",
              "inventory_depletion",
              "order_delivery",
              "price_change",
              "company_order",
              "other_supply_demand"
            ]
          }
        },
        "affected_product_or_service": {
          "type": "string",
          "minLength": 1
        },
        "gap_node": {
          "type": "string",
          "minLength": 1
        },
        "industry_evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "policy_only": {
          "const": false
        }
      }
    },
    "LeaderCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rank",
        "code",
        "name",
        "chain_node",
        "benefit_type",
        "profit_transmission_path",
        "business_materiality",
        "ownership_relation",
        "realization",
        "industry_evidence_refs",
        "company_evidence_refs",
        "uncertainties"
      ],
      "properties": {
        "rank": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "code": {
          "type": "string",
          "pattern": "^\\d{6}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "chain_node": {
          "type": "string",
          "minLength": 1
        },
        "benefit_type": {
          "enum": [
            "direct",
            "indirect",
            "conditional"
          ]
        },
        "profit_transmission_path": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "business_materiality": {
          "$ref": "#/$defs/BusinessMateriality"
        },
        "ownership_relation": {
          "$ref": "#/$defs/OwnershipRelation"
        },
        "realization": {
          "$ref": "#/$defs/Realization"
        },
        "industry_evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "company_evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "uncertainties": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "BusinessMateriality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "main_business_confirmed",
        "disclosure_mode",
        "revenue_share",
        "gross_profit_share",
        "official_qualitative_basis",
        "evidence_refs"
      ],
      "properties": {
        "main_business_confirmed": {
          "const": true
        },
        "disclosure_mode": {
          "enum": [
            "quantitative",
            "official_qualitative",
            "mixed"
          ]
        },
        "revenue_share": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "gross_profit_share": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "official_qualitative_basis": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "OwnershipRelation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relation_type",
        "holding_share",
        "attributable_profit_share",
        "official_qualitative_basis",
        "evidence_refs"
      ],
      "properties": {
        "relation_type": {
          "enum": [
            "listed_company_direct",
            "consolidated_subsidiary",
            "non_consolidated_associate"
          ]
        },
        "holding_share": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "attributable_profit_share": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "official_qualitative_basis": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "Realization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "expected_start",
        "basis",
        "evidence_refs"
      ],
      "properties": {
        "status": {
          "enum": [
            "current",
            "within_one_quarter",
            "conditional_within_one_quarter"
          ]
        },
        "expected_start": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "basis": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
